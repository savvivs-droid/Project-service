# Скопируйте этот файл в .env (тот же каталог) и заполните реальными
# значениями из Supabase Dashboard -> Project Settings -> API.
#
# Файл .env добавлен в .gitignore и никогда не должен попадать в git —
# в нём хранится адрес вашего проекта и публичный anon-ключ.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
